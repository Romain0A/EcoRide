{% extends 'base.html.twig' %}

{% block title %}
    Avis
{% endblock %}

{% block body %}
    {% embed 'header.html.twig' %} 
        {% block centre %}
            <p class="section"><b>Laisser un avis</b></p> 
        {% endblock %}
    {% endembed %}

    <div class="section connection ">
        {{ form_start(form) }}
            {{ form_row(form.note) }}
            {{ form_row(form.commentaire) }}
            <button type="submit">Envoyer</button>
        {{ form_end(form) }}
    </div>

{% endblock %}