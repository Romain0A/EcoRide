{% extends 'base.html.twig' %}

{% block title %}
    Espace employe
{% endblock %}

{% block body %}
    {% embed 'header.html.twig' %} {% endembed %}

    <div class="section scrolable">
        {% for avis in avis %}
            {% embed 'avis.html.twig' %} 
                {% block boutton_validation %}
                    <div>
                        <a href="{{ path('app_avis_accepter', {id: avis.id}) }}">
                            <button>Accepter</button>
                        </a>

                        <a href="{{ path('app_avis_refuser', {id: avis.id}) }}">
                            <button>Refuser</button>
                        </a>
                    </div>
                {% endblock %}
            {% endembed %}
        {% endfor %}
    </div>

    <div class="section scrolable">
        {% for malPasse in malPasse %}
            {% include 'malPasse.html.twig' %}
        {% endfor %}
    </div>

{% endblock %}