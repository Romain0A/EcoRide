<div class="sous_section">
    <div class="vboxleft">
        <img class="pfp img_petite" src={{ avis.pfp }} />
        <p>{{ avis.pseudo }}
            <br/>
            {% for i in 1..5 %}
                {% if i <= avis.note %}
                    ★
                {% else %}
                    ☆
                {% endif %}
            {% endfor %}
        </p>
    </div>
    <p>{{ avis.commentaire }}</p>
    {% block boutton_validation %}{% endblock %}
</div>