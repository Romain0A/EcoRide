{% extends 'base.html.twig' %}

{% block title %}
    Detail Covoiturage
{% endblock %}

{% block body %}
    {% embed 'header.html.twig' %}
        {% block centre %}
            <p id="resumer" class="section">{{ covoiturage.lieuDepart }} - {{ covoiturage.lieuArrivee }} ; {{ covoiturage.dateDepart|date('d/m/Y') }} - {{ covoiturage.dateArrivee|date('d/m/Y') }} ; {{ covoiturage.heureDepart|date('H:i') }} - {{ covoiturage.heureArrivee|date('H:i') }} ; {{ covoiturage.nbPlace }} place restante ; {{ covoiturage.prixPersonne }} credit</p>
        {% endblock %}
    {% endembed %}

    <div class="vbox">
        <div id="chauffeur" class="section column">
            <div class="vboxleft">
                <img class="pfp img_petite" src="/{{ covoiturage.chauffeur.photo }}" />
                <p>
                    {{ covoiturage.chauffeur.pseudo }}
                    <br/>
                    {% for i in 1..5 %}
                        {% if i <= covoiturage.chauffeur.note %}
                            ★
                        {% else %}
                            ☆
                        {% endif %}
                    {% endfor %}
                </p>
            </div><br/>
            <p>
                preference:<br/>{{ covoiturage.chauffeur.preference }}
            </p>
        </div>

        <div id="vehicule" class="section column">
            <p>vehicule:</p>
            <p>Modele: {{ covoiturage.voiture.modele }}</br>Marque: {{ covoiturage.voiture.marque }}</br>Couleur: {{ covoiturage.voiture.couleur }}</br>Energie: {{ covoiturage.voiture.energie }}</p>
        </div>
    </div>

    <div id="avisList" class="scrolable section">
        {% for avis in covoiturage.chauffeur.avisRecus %}
            {% if avis.statut == 'valide' %}
                {% include 'avis.html.twig' %}
            {% endif %}
        {% endfor %}
    </div>

    <a href="participer/{{ covoiturage.id }}" class="section connection">Participer</a>

{% endblock %}