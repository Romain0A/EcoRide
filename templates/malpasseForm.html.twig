{% extends 'base.html.twig' %}

{% block title %}
    Mal Passe
{% endblock %}

{% block body %}
    {% embed 'header.html.twig' %} 
        {% block centre %}
            <p class="section"><b>Signaler un problème</b></p> 
        {% endblock %}
    {% endembed %}

    <form method="post" class="section connection ">
        <label>Expliquez le problème :</label>
        <br>
        <textarea name="commentaire" required></textarea>
        <br>
        <button type="submit">Envoyer</button>
    </form>

{% endblock %}