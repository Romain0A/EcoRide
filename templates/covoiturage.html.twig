<img class="pfp img_petite" src="/{{ covoiturage.chauffeur.photo }}" />
<p>{{ covoiturage.chauffeur.pseudo }}
<br/>
{% for i in 1..5 %}
    {% if i <= covoiturage.chauffeur.note %}
        ★
    {% else %}
        ☆
    {% endif %}
{% endfor %}</p>
<p>Place restante:<br/>{{ covoiturage.nbPlace }}</p>
<p>Prix voyage:<br/>{{ covoiturage.prixPersonne }} crédit</p>
<p>Départ:<br/>{{ covoiturage.dateDepart|date('d/m/Y') }}<br/>{{ covoiturage.heureDepart|date('H:i') }}</p>
<p>Arrivée:<br/>{{ covoiturage.dateArrivee|date('d/m/Y') }}<br/>{{ covoiturage.heureArrivee|date('H:i') }}</p>
<p>Voyage<br/> 
    {% if covoiturage.voiture.energie == 'electrique' %}
        Ecologique
        {% else %}
        Non écologique
    {% endif %}</p>
{% block status %} {% endblock %}
<a href="/detail?id={{ covoiturage.id }}"><img class="img_petite" src='\img\icones\material-symbols--lists-rounded.png' alt='Details'/></a>