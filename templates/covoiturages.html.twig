{% extends 'base.html.twig' %}

{% block title %}
    Covoiturages
{% endblock %}

{% block body %}
    {% embed 'header.html.twig' %}
        {% block centre %}
            
        {% endblock %}
    {% endembed %}

    {{ form_start(form) }}
        <div id='trie' class= "vbox_evenly wrap">
            {{ form_row(form.lieu_depart) }}
            {{ form_row(form.lieu_arrivee) }}
            {{ form_row(form.date_depart) }}
            {{ form_row(form.prix_personne) }}
            {{ form_row(form.ecologique) }}
            <button type="submit">Rechercher</button>
        </div>
    {{ form_end(form) }}

    <div id="listCovoiturage" class="scrolable">
    {% for covoiturage in covoiturages %}
        <div class="section vbox_evenly wrap">
            {% if covoiturage.nbPlace > 0 %}
                {% include 'covoiturage.html.twig' %}
            {% endif %}
        </div>
    {% endfor %}
    </div>
{% endblock %}