{% extends 'base.html.twig' %}

{% block title %}
    Change mot de passe
{% endblock %}

{% block body %}
    {% embed 'header.html.twig' %} 
        {% block centre %}
            <p class="section"><b>Modifier mon mot de passe</b></p> 
        {% endblock %}
    {% endembed %}

    <div class="section connection">
        {{ form_start(form) }}
            {{ form_row(form.currentPassword) }}
            {{ form_row(form.newPassword) }}
            <button type="submit">Valider</button>
        {{ form_end(form) }}
    </div>

{% endblock %}