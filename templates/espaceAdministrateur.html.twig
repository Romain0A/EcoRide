{% extends 'base.html.twig' %}

{% block title %}
    Espace Administrateur
{% endblock %}

{% block body %}

    {% embed 'header.html.twig' %} {% endembed %}
    
    <div class="scrolable">

        <div class="vbox wrap">
            <div class="section">
                <p>Nombre de covoiturage</p>
                {{ render_chart(grapheCredits) }}
            </div>

            <div class="section">
                <p>Crédit gagner</p>
                {{ render_chart(grapheCovoiturage) }}
                <p>Total: {{ totalCredit }}</p>
            </div>
        </div>

        <form method="post" action="/creer_employe" class="section vbox_evenly wrap">
            <input type="text" name="pseudo" placeholder="Pseudo"/>
            <input type="text" name="email" placeholder="Email compte"/>
            <input type="text" name="nom" placeholder="Nom"/>
            <input type="text" name="prenom" placeholder="prenom"/>
            <input type="text" name="telephone" placeholder="telephone"/>
            <input type="text" name="adresse" placeholder="adresse"/>
            <input type="date" name="date_naissance" placeholder="date naissance"/>
            <button type="submit">Créer compte employé</button>
        </form>

        <form method="post" action="/supprimer_compte" class="section vbox_evenly">
            <input type="text" name="email" placeholder="Email compte"/>
            <button type="submit">Supprimer le compte</button>
        </form>

    </div>

{% endblock %}